# Copy this file to deploy/docker/.env (ignored by Git) and replace the
# placeholders with site values. Never commit the copy.

# Folders holding Frigate's site data: configuration, database, trained
# models, snapshots and clips. Relative paths start at deploy/docker.
STACK_FRIGATE_CONFIG_DIR=../../runtime/frigate/config
STACK_FRIGATE_MEDIA_DIR=../../runtime/frigate/media

# One variable per go2rtc source in config.yml, written there as {NAME}.
# Frigate only substitutes variables whose name starts with FRIGATE_.
# URL-encode reserved characters in passwords (@ : / % { }), and wrap a value
# in single quotes if it contains $.
FRIGATE_HIKVISION_EXAMPLE_MAIN_URL=rtsp://USER:PASSWORD@192.168.1.XXX:554/Streaming/Channels/101
FRIGATE_HIKVISION_EXAMPLE_SUB_URL=rtsp://USER:PASSWORD@192.168.1.XXX:554/Streaming/Channels/102
FRIGATE_EUFY_EXAMPLE_URL=rtsp://USER:PASSWORD@192.168.1.XXX:554/live0
