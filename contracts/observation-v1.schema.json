{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/contracts/observation-v1.schema.json",
  "title": "Normalized camera observation",
  "type": "object",
  "required": ["schema_version", "message_id", "observation_id", "source", "camera_id", "phase", "ingested_at", "subject", "media", "quality", "source_data"],
  "properties": {
    "schema_version": { "const": "observation.v1" },
    "message_id": { "type": "string", "minLength": 1 },
    "observation_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["dahua", "frigate"] },
        "instance_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "camera_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["observation", "new", "update", "end"] },
    "observed_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["type", "local_track_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "local_track_id": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "geometry": { "type": ["object", "null"] },
    "zones": {
      "type": "object",
      "properties": {
        "current": { "type": "array", "items": { "type": "string" } },
        "entered": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "attributes": { "type": "object" },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content_type", "path"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "content_type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "relationships": { "type": "object" },
    "quality": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "enum": ["partial", "complete"] } },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "properties": {
        "camera_observed_at": { "type": ["string", "null"], "format": "date-time" },
        "cgi_received_at": { "type": ["string", "null"], "format": "date-time" },
        "netsdk_callback_received_at": { "type": ["string", "null"], "format": "date-time" },
        "netsdk_python_received_at": { "type": ["string", "null"], "format": "date-time" },
        "normalized_at": { "type": ["string", "null"], "format": "date-time" },
        "collector_published_at": { "type": ["string", "null"], "format": "date-time" },
        "correlation_wait_ms": { "type": ["number", "null"] },
        "source_timestamps": { "type": "object" }
      },
      "additionalProperties": true
    },
    "source_data": { "type": "object" },
    "raw": { "type": "object" }
  },
  "additionalProperties": true
}
